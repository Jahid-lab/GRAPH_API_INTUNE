## This installs the required modules on device

Install-Module Microsoft.Graph.Authentication -Scope AllUsers
Install-Module Microsoft.Graph.Groups -Scope AllUsers
Install-Module Microsoft.Graph.Identity.DirectoryManagement -Scope AllUsers


## connects to Microsoft graph api
Connect-MgGraph -Scopes "GroupMember.ReadWrite.All","Device.Read.All" -UseDeviceCode


## moves devices into GROUPNAME WITH THE SERIAL TAGS (HOSTNAMES)

$groupName = "xxx (GROUPNAME)"
$deviceListPath = "C:\(PATH-WAY TO devices.txt"   # one device name per line

if (-not (Test-Path $deviceListPath)) {
    Write-Host "Device list file not found: $deviceListPath" -ForegroundColor Red
    return
}

$deviceNames = Get-Content -Path $deviceListPath | Where-Object { $_.Trim() -ne "" }

$group = Get-MgGroup -Filter "displayName eq '$groupName'"

$failures = @()
foreach ($name in $deviceNames) {
    $name = $name.Trim()
    $device = Get-MgDevice -Filter "displayName eq '$name'"
    if (-not $device) {
        Write-Host "NOT FOUND: $name" -ForegroundColor Red
        $failures += "$name - device not found in Entra"
        continue
    }
    try {
        New-MgGroupMemberByRef -GroupId $group.Id -BodyParameter @{
            "@odata.id" = "https://graph.microsoft.com/v1.0/devices/$($device.Id)"
        }
        Write-Host "ADDED: $name" -ForegroundColor Green
    } catch {
        Write-Host "FAILED: $name - $($_.Exception.Message)" -ForegroundColor Yellow
        $failures += "$name - $($_.Exception.Message)"
    }
}

Write-Host "`n--- SUMMARY ---"
if ($failures.Count -eq 0) {
    Write-Host "All devices added successfully." -ForegroundColor Green
} else {
    Write-Host "$($failures.Count) failure(s):" -ForegroundColor Red
    $failures | ForEach-Object { Write-Host $_ -ForegroundColor Red }
}
