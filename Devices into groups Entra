$ErrorActionPreference = "Stop"
$ExportPath = Join-Path $env:USERPROFILE "Documents\EUC-Exports"

$Scopes = @(
    "DeviceManagementManagedDevices.Read.All"
    "DeviceManagementApps.Read.All"
    "DeviceManagementConfiguration.Read.All"
    "DeviceManagementServiceConfig.Read.All"
    "Group.Read.All"
    "Device.Read.All"
)

function Get-GraphAll {
    param([Parameter(Mandatory)][string]$Uri)

    $Results = @()

    do {
        $Response = Invoke-MgGraphRequest -Method GET -Uri $Uri -ErrorAction Stop

        if ($null -ne $Response.value) {
            $Results += @($Response.value)
        }

        $Uri = $Response.'@odata.nextLink'
    } while ($Uri)

    return $Results
}

# Display results first; CSV export is optional.
function Export-Results {
    param(
        [Parameter(Mandatory)][object[]]$Data,
        [Parameter(Mandatory)][string]$Name
    )

    if ($Data.Count -eq 0) {
        Write-Host "`nNo results found." -ForegroundColor Yellow
        return
    }

    Write-Host "`nFound $($Data.Count) result(s)." -ForegroundColor Green
    $Data | Format-Table -AutoSize -Wrap

    $Save = Read-Host "`nWould you like to export these results to CSV? (Y/N)"

    if ($Save -notmatch '^(Y|YES)$') {
        Write-Host "Results displayed only. No CSV created."
        return
    }

    if (-not (Test-Path $ExportPath)) {
        New-Item -Path $ExportPath -ItemType Directory -Force |
            Out-Null
    }

    $File = Join-Path $ExportPath (
        "$Name-" + (Get-Date -Format "yyyyMMdd-HHmmss") + ".csv"
    )

    $Data | Export-Csv -Path $File -NoTypeInformation -Encoding UTF8

    Write-Host "`nExported to: $File" -ForegroundColor Green
}

# Resolve an assignment target to a readable name.
function Get-AssignmentTargetName {
    param(
        [Parameter(Mandatory)][object]$Target,
        [Parameter(Mandatory)][hashtable]$GroupCache
    )

    $Type = $Target.'@odata.type'
    $GroupId = $Target.groupId

    if ($GroupId) {
        if (-not $GroupCache.ContainsKey($GroupId)) {
            try {
                $Group = Invoke-MgGraphRequest -Method GET -Uri (
                    "https://graph.microsoft.com/v1.0/groups/$GroupId" +
                    "?`$select=id,displayName"
                ) -ErrorAction Stop

                $GroupCache[$GroupId] = $Group.displayName
            }
            catch {
                $GroupCache[$GroupId] = "Unable to resolve group name"
            }
        }

        return $GroupCache[$GroupId]
    }

    switch ($Type) {
        "#microsoft.graph.allLicensedUsersAssignmentTarget" {
            return "All Licensed Users"
        }
        "#microsoft.graph.allUsersAssignmentTarget" {
            return "All Users"
        }
        "#microsoft.graph.allDevicesAssignmentTarget" {
            return "All Devices"
        }
        default {
            return $Type -replace '^#microsoft\.graph\.', ''
        }
    }
}



# OPTION 1: Search apps by name, version, platform and assignments.
function Find-AppsByName {
    $Search = Read-Host "Enter part of the application name (e.g. Adobe)"

    if ([string]::IsNullOrWhiteSpace($Search)) {
        return
    }

    Write-Host "`nSearching Intune applications for '$Search'..." `
        -ForegroundColor Cyan

    # Retrieve the app list using the original working endpoint.
    $AllApps = Get-GraphAll (
        "https://graph.microsoft.com/v1.0/deviceAppManagement/mobileApps?`$select=id,displayName"
    )

    $Apps = @(
        $AllApps | Where-Object {
            $_.displayName -like "*$Search*"
        }
    )

    if ($Apps.Count -eq 0) {
        Write-Host "No application names matched '$Search'." `
            -ForegroundColor Yellow
        return
    }

    Write-Host "Found $($Apps.Count) matching application(s)." `
        -ForegroundColor Green

    $Results = @()
    $GroupCache = @{}

    foreach ($App in $Apps) {
        Write-Host "Checking: $($App.displayName)"

        try {
            # Retrieve details individually because app properties vary by type.
            $AppDetails = Invoke-MgGraphRequest `
                -Method GET `
                -Uri "https://graph.microsoft.com/beta/deviceAppManagement/mobileApps/$($App.id)"

            $AppType = $AppDetails.'@odata.type'

            # Identify the app platform from its Intune app type.
            $Platform = switch -Regex ($AppType) {
                'win32LobApp|winGetApp|windowsMobileMSI|windowsUniversalAppX|windowsStoreApp|windowsWebApp|windowsMicrosoftEdgeApp' {
                    "Windows"
                    break
                }
                'iosLobApp|iosStoreApp|iosVppApp|managedIOSLobApp' {
                    "iOS"
                    break
                }
                'androidLobApp|androidStoreApp|managedAndroidLobApp|androidManagedStoreApp' {
                    "Android"
                    break
                }
                'macOS|macOSLobApp|macOSDmgApp|macOSPkgApp' {
                    "macOS"
                    break
                }
                default {
                    "Other/Unknown"
                }
            }

            # Version fields differ between Intune app types.
            $Version = $AppDetails.displayVersion

            if ([string]::IsNullOrWhiteSpace([string]$Version)) {
                $Version = $AppDetails.displayVersionNumber
            }

            if ([string]::IsNullOrWhiteSpace([string]$Version)) {
                $Version = "Not exposed"
            }

            # Retrieve assignments.
            $Assignments = @(
                Get-GraphAll (
                    "https://graph.microsoft.com/v1.0/deviceAppManagement/mobileApps/$($App.id)/assignments"
                )
            )

            if ($Assignments.Count -eq 0) {
                $Results += [PSCustomObject]@{
                    AppName        = $App.displayName
                    Platform       = $Platform
                    AppVersion     = $Version
                    AppType        = $AppType
                    AppId          = $App.id
                    Intent         = "No assignments"
                    AssignmentType = ""
                    GroupName      = ""
                    TargetType     = ""
                    TargetGroupId  = ""
                    AssignmentId   = ""
                    FilterId       = ""
                    FilterType     = ""
                }

                continue
            }

            foreach ($A in $Assignments) {
                $Target = $A.target
                $TargetType = $Target.'@odata.type'

                if ($TargetType -eq "#microsoft.graph.exclusionGroupAssignmentTarget") {
                    $AssignmentType = "Excluded"
                }
                elseif ($TargetType -eq "#microsoft.graph.groupAssignmentTarget") {
                    $AssignmentType = "Included"
                }
                else {
                    $AssignmentType = "Broad/Other target"
                }

                $TargetName = Get-AssignmentTargetName `
                    -Target $Target `
                    -GroupCache $GroupCache

                $Results += [PSCustomObject]@{
                    AppName        = $App.displayName
                    Platform       = $Platform
                    AppVersion     = $Version
                    AppType        = $AppType
                    AppId          = $App.id
                    Intent         = $A.intent
                    AssignmentType = $AssignmentType
                    GroupName      = $TargetName
                    TargetType     = $TargetType
                    TargetGroupId  = $Target.groupId
                    AssignmentId   = $A.id
                    FilterId       = $A.deviceAndAppManagementAssignmentFilterId
                    FilterType     = $A.deviceAndAppManagementAssignmentFilterType
                }
            }
        }
        catch {
            Write-Warning "Could not retrieve '$($App.displayName)': $($_.Exception.Message)"
        }
    }

    $Results = @(
        $Results | Sort-Object AppName, Intent, AssignmentType, GroupName
    )

    if ($Results.Count -eq 0) {
        Write-Host "No application assignment results were retrieved." `
            -ForegroundColor Yellow
        return
    }

    Export-Results -Data $Results -Name "ApplicationAssignments"
}


# OPTION 2: Find apps included or excluded for a specific Entra group.
function Find-GroupApps {
    $Name = Read-Host "Enter Entra group display name"

    if ([string]::IsNullOrWhiteSpace($Name)) {
        return
    }

    $SafeName = $Name.Replace("'", "''")
    $Filter = [uri]::EscapeDataString("displayName eq '$SafeName'")

    $Groups = @(
        Get-GraphAll (
            "https://graph.microsoft.com/v1.0/groups?`$filter=$Filter&`$select=id,displayName"
        )
    )

    if ($Groups.Count -ne 1) {
        Write-Host "Expected one exact group match; found $($Groups.Count)." `
            -ForegroundColor Yellow

        if ($Groups.Count -gt 1) {
            $Groups | Select-Object displayName, id | Format-Table -AutoSize
        }

        return
    }

    $Group = $Groups[0]

    Write-Host "`nGroup: $($Group.displayName)" -ForegroundColor Cyan
    Write-Host "Group ID: $($Group.id)"
    Write-Host "Checking Intune app assignments..."

    $Apps = Get-GraphAll (
        "https://graph.microsoft.com/v1.0/deviceAppManagement/mobileApps?`$select=id,displayName"
    )

    $Results = @()

    foreach ($App in $Apps) {
        try {
            $Assignments = Get-GraphAll (
                "https://graph.microsoft.com/v1.0/deviceAppManagement/mobileApps/$($App.id)/assignments"
            )

            foreach ($A in $Assignments) {
                $Target = $A.target
                $TargetType = $Target.'@odata.type'

                if (
                    $Target.groupId -eq $Group.id -and
                    $TargetType -in @(
                        "#microsoft.graph.groupAssignmentTarget",
                        "#microsoft.graph.exclusionGroupAssignmentTarget"
                    )
                ) {
                    if ($TargetType -eq "#microsoft.graph.exclusionGroupAssignmentTarget") {
                        $AssignmentType = "Excluded"
                    }
                    else {
                        $AssignmentType = "Included"
                    }

                    $Results += [PSCustomObject]@{
                        GroupName      = $Group.displayName
                        AppName        = $App.displayName
                        AppId          = $App.id
                        Intent         = $A.intent
                        AssignmentType = $AssignmentType
                        AssignmentId   = $A.id
                        TargetType     = $TargetType
                        TargetGroupId  = $Target.groupId
                        FilterId       = $Target.deviceAndAppManagementAssignmentFilterId
                        FilterType     = $Target.deviceAndAppManagementAssignmentFilterType
                    }
                }
            }
        }
        catch {
            Write-Warning "Could not read assignments for '$($App.displayName)': $($_.Exception.Message)"
        }
    }

    $Results = @(
        $Results | Sort-Object AppName, Intent, AssignmentType
    )

    Export-Results -Data $Results -Name "GroupAppAssignments"
}



# OPTION 3: Show unique device hostnames where the selected app is reported as installed.
function Find-AppInstalledDevices {
    $SearchName = Read-Host "Enter application name"

    if ([string]::IsNullOrWhiteSpace($SearchName)) {
        Write-Host "Application name cannot be empty." -ForegroundColor Yellow
        return
    }

    # Initialise temporary paths for cleanup.
    $WorkFolder = $null
    $ZipPath = $null

    try {
        # Find applications, including subsequent Graph pages.
        $Apps = Get-GraphAll (
            "https://graph.microsoft.com/v1.0/deviceAppManagement/mobileApps?`$select=id,displayName"
        )

        $Matches = @(
            $Apps | Where-Object {
                $_.displayName -like "*$SearchName*"
            }
        )

        if ($Matches.Count -eq 0) {
            Write-Host "Application not found." -ForegroundColor Yellow
            return
        }

        # Ask the user to select the correct app if several match.
        if ($Matches.Count -gt 1) {
            for ($i = 0; $i -lt $Matches.Count; $i++) {
                Write-Host "$($i + 1). $($Matches[$i].displayName)"
            }

            $Choice = Read-Host "Enter application number"

            if (
                $Choice -notmatch '^\d+$' -or
                [int]$Choice -lt 1 -or
                [int]$Choice -gt $Matches.Count
            ) {
                Write-Host "Invalid selection." -ForegroundColor Yellow
                return
            }

            $App = $Matches[[int]$Choice - 1]
        }
        else {
            $App = $Matches[0]
        }

        $AppId = $App.id
        $AppName = $App.displayName

        Write-Host "`nApplication: $AppName" -ForegroundColor Cyan
        Write-Host "Generating Intune installation report..."

        # Create the Intune installation report.
        $Body = @{
            reportName = "DeviceInstallStatusByApp"
            filter     = "(ApplicationId eq '$AppId')"
            format     = "csv"
            select     = @(
                "DeviceName"
                "ApplicationId"
                "AppInstallState"
                "InstallState"
                "ErrorCode"
            )
        } | ConvertTo-Json -Depth 5

        $ReportUri = "https://graph.microsoft.com/beta/deviceManagement/reports/exportJobs"

        $Job = Invoke-MgGraphRequest -Method POST `
            -Uri $ReportUri `
            -ContentType "application/json" `
            -Body $Body `
            -ErrorAction Stop

        # Wait for report generation.
        $Deadline = (Get-Date).AddMinutes(3)

        do {
            if ((Get-Date) -ge $Deadline) {
                throw "Timed out waiting for the installation report."
            }

            Start-Sleep -Seconds 5

            $Job = Invoke-MgGraphRequest -Method GET `
                -Uri "$ReportUri/$($Job.id)" `
                -ErrorAction Stop

        } while ($Job.status -in @("notStarted", "inProgress"))

        if ($Job.status -ne "completed") {
            throw "Report generation status: $($Job.status)"
        }

        if ([string]::IsNullOrWhiteSpace($Job.url)) {
            throw "The report completed but no download URL was returned."
        }

        # Download and extract the CSV report to a temporary folder.
        $WorkFolder = Join-Path $env:TEMP "JM-EUC-AppInstall-$($Job.id)"
        $ZipPath = "$WorkFolder.zip"

        New-Item -ItemType Directory -Path $WorkFolder -Force | Out-Null

        Invoke-WebRequest -Uri $Job.url -OutFile $ZipPath -ErrorAction Stop
        Expand-Archive -Path $ZipPath -DestinationPath $WorkFolder -Force

        $CsvFile = Get-ChildItem -Path $WorkFolder -Filter "*.csv" |
            Select-Object -First 1

        if (-not $CsvFile) {
            throw "No CSV report was returned."
        }

        $Rows = @(Import-Csv -Path $CsvFile.FullName)

        if ($Rows.Count -eq 0) {
            Write-Host "No installation records returned." -ForegroundColor Yellow
            return
        }

        # Filter to devices reported as Installed.
        $InstalledRows = @(
            $Rows | Where-Object {
                $_.AppInstallState_loc -eq "Installed" -or
                $_.AppInstallState -eq "S1"
            }
        )

        $Devices = @(
            $InstalledRows |
                Where-Object {
                    -not [string]::IsNullOrWhiteSpace($_.DeviceName)
                } |
                Select-Object -ExpandProperty DeviceName -Unique |
                Sort-Object
        )

        if ($Devices.Count -gt 0) {
            Write-Host "`nInstalled on $($Devices.Count) devices:" -ForegroundColor Green
            $Devices | ForEach-Object { Write-Host $_ }
        }
        else {
            Write-Host "No installed devices found in the report." -ForegroundColor Yellow
        }

        # Ask whether to save the report as a CSV.
        do {
            $SaveReport = Read-Host "`nExport report to CSV? (Y/N)"
        } while ($SaveReport -notmatch '^[YyNn]$')

        if ($SaveReport -match '^[Yy]$') {
            # Use the existing EUC export location.
            if (-not (Test-Path $ExportPath)) {
                New-Item -ItemType Directory -Path $ExportPath -Force | Out-Null
            }

            $SafeAppName = $AppName -replace '[^\w-]', '_'
            $Timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
            $ExportFile = Join-Path $ExportPath "AppInstallStatus_${SafeAppName}_${Timestamp}.csv"

            if ($InstalledRows.Count -gt 0) {
                $InstalledRows |
                    Sort-Object DeviceName -Unique |
                    Export-Csv -Path $ExportFile -NoTypeInformation -Encoding UTF8
            }
            else {
                # Create an empty CSV with the report columns.
                $Rows |
                    Select-Object -First 0 |
                    Export-Csv -Path $ExportFile -NoTypeInformation -Encoding UTF8
            }

            Write-Host "`nReport exported successfully:" -ForegroundColor Green
            Write-Host $ExportFile
        }
        else {
            Write-Host "CSV export skipped." -ForegroundColor Yellow
        }
    }
    catch {
        Write-Host "Unable to retrieve installation data: $($_.Exception.Message)" `
            -ForegroundColor Red
    }
    finally {
        # Clean up temporary files without touching the final exported CSV.
        if ($WorkFolder -and (Test-Path $WorkFolder)) {
            Remove-Item -Path $WorkFolder -Recurse -Force -ErrorAction SilentlyContinue
        }

        if ($ZipPath -and (Test-Path $ZipPath)) {
            Remove-Item -Path $ZipPath -Force -ErrorAction SilentlyContinue
        }
    }
}

# OPTION 4: Autopilot device lookup.
function Find-Autopilot {
    $Search = Read-Host "Enter hostname or serial number"

    if ([string]::IsNullOrWhiteSpace($Search)) {
        return
    }

    $Devices = Get-GraphAll (
        "https://graph.microsoft.com/v1.0/deviceManagement/windowsAutopilotDeviceIdentities"
    )

    $Matches = @(
        $Devices | Where-Object {
            $_.serialNumber -like "*$Search*" -or
            $_.displayName -like "*$Search*" -or
            $_.resourceName -like "*$Search*"
        }
    )

    $Results = foreach ($D in $Matches) {
        [PSCustomObject]@{
            DisplayName     = $D.displayName
            SerialNumber    = $D.serialNumber
            GroupTag        = $D.groupTag
            Manufacturer    = $D.manufacturer
            Model           = $D.model
            EnrollmentState = $D.enrollmentState
            LastContacted   = $D.lastContactedDateTime
            AutopilotId     = $D.id
            ManagedDeviceId = $D.managedDeviceId
        }
    }

    Export-Results -Data @($Results) -Name "AutopilotLookup"
}


# OPTION 5: Show direct Entra group memberships for a device.
function Compare-DeviceGroups {
    $Name = Read-Host "Enter device hostname"

    if ([string]::IsNullOrWhiteSpace($Name)) {
        return
    }

    try {
        $SafeName = $Name.Replace("'", "''")
        $Filter = [uri]::EscapeDataString("deviceName eq '$SafeName'")

        # Find the device in Intune.
        $ManagedDevices = @(
            Get-GraphAll (
                "https://graph.microsoft.com/v1.0/deviceManagement/managedDevices?`$filter=$Filter&`$select=id,deviceName,azureADDeviceId"
            )
        )

        if ($ManagedDevices.Count -eq 0) {
            Write-Host "Device '$Name' was not found in Intune." -ForegroundColor Yellow
            return
        }

        $Results = @()

        foreach ($D in $ManagedDevices) {
            if ([string]::IsNullOrWhiteSpace($D.azureADDeviceId)) {
                Write-Host "No Entra device ID is recorded for $($D.deviceName)." `
                    -ForegroundColor Yellow
                continue
            }

            # Resolve the Entra device ID to its directory object ID.
            $DeviceId = $D.azureADDeviceId
            $DeviceFilter = [uri]::EscapeDataString("deviceId eq '$DeviceId'")

            $EntraDevices = @(
                Get-GraphAll (
                    "https://graph.microsoft.com/v1.0/devices?`$filter=$DeviceFilter&`$select=id,displayName,deviceId"
                )
            )

            if ($EntraDevices.Count -eq 0) {
                Write-Host "No matching Entra device object found for $($D.deviceName)." `
                    -ForegroundColor Yellow
                continue
            }

            foreach ($EntraDevice in $EntraDevices) {
                # Use the directory object ID for the memberOf request.
                $Memberships = @(
                    Get-GraphAll (
                        "https://graph.microsoft.com/v1.0/devices/$($EntraDevice.id)/memberOf"
                    )
                )

                foreach ($M in $Memberships) {
                    if ($M.'@odata.type' -eq "#microsoft.graph.group") {
                        $Results += [PSCustomObject]@{
                            DeviceName = $D.deviceName
                            GroupName  = $M.displayName
                            GroupId    = $M.id
                        }
                    }
                }
            }
        }

        if ($Results.Count -eq 0) {
            Write-Host "No direct Entra group memberships found for '$Name'." `
                -ForegroundColor Yellow
            return
        }

        $Results = @(
            $Results | Sort-Object DeviceName, GroupName -Unique
        )

        Export-Results -Data $Results -Name "DeviceGroupMembership"
    }
    catch {
        Write-Host "Unable to retrieve device group memberships: $($_.Exception.Message)" `
            -ForegroundColor Red
    }
}


# OPTION 6: Export Windows workstation inventory only.
function Export-DeviceInventory {
    Write-Host "Retrieving Windows workstation inventory..."

    $Devices = Get-GraphAll (
        "https://graph.microsoft.com/v1.0/deviceManagement/managedDevices?`$select=deviceName,serialNumber,manufacturer,model,operatingSystem,osVersion,userPrincipalName,complianceState,lastSyncDateTime,azureADDeviceId,id,deviceEnrollmentType"
    )


# Keep only Windows 11 workstations.
$Workstations = @(
    $Devices | Where-Object {
        $_.operatingSystem -eq "Windows" -and
        $_.deviceName -like "xxx*" -and
        $_.osVersion -match '^10\.0\.(\d+)' -and
        [int]$Matches[1] -ge 22000
    }
)


    $Results = foreach ($D in $Workstations) {
        [PSCustomObject]@{
            DeviceName      = $D.deviceName
            SerialNumber    = $D.serialNumber
            Manufacturer    = $D.manufacturer
            Model           = $D.model
            OS              = $D.operatingSystem
            OSVersion       = $D.osVersion
            User            = $D.userPrincipalName
            Compliance      = $D.complianceState
            LastSync        = $D.lastSyncDateTime
            EntraDeviceId   = $D.azureADDeviceId
            ManagedDeviceId = $D.id
            EnrollmentType  = $D.deviceEnrollmentType
        }
    }

    Write-Host "Found $($Workstations.Count) Windows workstation(s)." `
        -ForegroundColor Green

    Export-Results -Data @($Results) -Name "WindowsWorkstationInventory"
}


